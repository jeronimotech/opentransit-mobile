#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Alternate launcher icons, one per city. Generated by tool/city_icons.py:
// the names must match the .appiconset folders in Assets.xcassets, and the
// INCLUDE_ALL setting is what makes the compiler emit them at all.
ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS = YES
ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES = AppIcon-bogota AppIcon-boston AppIcon-brisbane AppIcon-casablanca AppIcon-kualalumpur AppIcon-lisboa AppIcon-roma AppIcon-santiago AppIcon-toronto
