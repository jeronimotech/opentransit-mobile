<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Manual-signing export used by tool/testflight.sh (SIGNING=manual, the default).
	     Placeholders are replaced at build time: __TEAM_ID__, __BUNDLE_ID__, __PROFILE_NAME__,
	     __CERT__ ("Apple Distribution" or "iPhone Distribution", whichever the keychain holds). -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>teamID</key>
	<string>__TEAM_ID__</string>
	<key>signingCertificate</key>
	<string>__CERT__</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>__BUNDLE_ID__</key>
		<string>__PROFILE_NAME__</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
